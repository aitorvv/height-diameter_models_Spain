@inproceedings{gomez-garcia_relacion_2013-1,
	title = {Relación altura-diámetro generalizada para rodales regulares de \textit{{Quercus}} robur {L}. en {Galicia}},
	url = {https://www.congresoforestal.es/fichero.php?t=41725&i=4868&m=2185},
	abstract = {En este trabajo se ha desarrollado una relación altura-diámetro (h-d) generalizada para rodales regulares de roble (Quercus robur L.) existentes en Galicia. Para ello se utilizaron 7569 pares de datos h-d pertenecientes a 263 inventarios, que se realizaron en 172 parcelas de investigación situadas en la comunidad gallega. Se evaluaron modelos existentes en la literatura, así como modificaciones de los mismos. De los 26 modelos analizados el que mejores resultados proporcionó fue una modificación de un modelo propuesto por TOMÉ (1988), que explicó el 73,2 \% de la variabilidad observada y estimó la altura total con un error medio de 2,24 m. Este modelo usa como variables independientes, además del diámetro normal, las variables de rodal altura dominante, diámetro dominante y número de pies por hectárea},
	booktitle = {Actas del 6º {Congreso} {Forestal} {Español}, {Vitoria}-{Gasteiz}},
	author = {Gómez-García, E},
	year = {2013},
}

@inproceedings{castano-santamaria_relaciones_2009-1,
	title = {Relaciones altura-diámetro generalizadas para las masas naturales de \textit{{Quercus}} pyrenaica {Willd}. en las vertientes castellano-leonesas de la {Cordillera} {Cantábrica} y del {Sistema} {Central}},
	url = {https://www.congresoforestal.es/fichero.php?t=41725&i=134&m=2185},
	abstract = {En el presente trabajo, se ajustaron varias relaciones altura-diámetro generalizadas para las masas naturales de Quercus pyrenaica Willd. ubicadas en las vertientes castellano-leonesas de la Cordillera Cantábrica y el Sistema Central, para aquellos ejemplares cuyo porte se encuadra como forma de cubicación 2, 3 y 4, según criterio del Inventario Forestal Nacional. El objetivo principal fue comprobar si era posible aplicar un único modelo altura-diámetro, que explicase la amplia variabilidad habitacional y morfológica de la especie en el área de estudio. El conjunto de datos utilizado se obtuvo de la base de datos del Segundo Inventario Forestal Nacional, considerando 360 parcelas en las que el rebollo supone la especie dominante, y en las que se midieron, entre otras variables, el diámetro normal y la altura total. Se evaluaron 31 modelos altura-diámetro que fueron ajustados usando tanto procedimientos de regresión lineal, como no lineal. Posteriormente, y tras la pertinente validación del modelo, a fin de determinar la variabilidad interregional entre la Cordillera Cantábrica y el Sistema Central, así como la existente entre las formas de cubicación y entre los grupos que se obtienen de la interacción de ambas variables categóricas, la región y la forma se incluyeron en el modelo mediante el empleo de variables dummy. Los resultados mostraron la necesidad de elaborar una ecuación específica para cada categoría de las comparadas, lo que reveló la especificidad de cada tipología de masa de rebollo contemplada.},
	booktitle = {Actas del 5º {Congreso} {Forestal} {Español}, Ávila},
	author = {Castaño-Santamaría, J and Herrero De Aza, C and Bravo-Oviedo, A and Bravo, F},
	year = {2009},
}

@inproceedings{diaz_rodriguez_relacion_2009-1,
	title = {Relación altura-diámetro generalizada para masas de \textit{{Eucalyptus}} globulus {Labill}. en {Galicia}},
	url = {https://www.congresoforestal.es/fichero.php?t=41725&i=191&m=2185},
	abstract = {El eucalipto blanco (Eucalyptus globulus Labill.) y el pino marítimo (Pinus pinaster L.) agrupan el 55\% de los pies mayores y el 64\% del volumen de madera existente en Galicia. Una adecuada gestión de las masas de eucalipto precisa del conocimiento detallado de las existencias de las mismas. En este sentido, los costes de la obtención de la altura de los árboles son muy elevados con respecto a los de la medición del diámetro, motivo por el cual es útil desarrollar modelos de predicción de la altura a partir del diámetro normal medido. En este trabajo se ha desarrollado una relación altura-diámetro generalizada para masas puras regulares de E. globulus en Galicia. El modelo se ajustó a los pares de datos altura-diámetro de 23.665 árboles, que fueron tomados en 955 parcelas del Segundo y del Tercer Inventario Forestal Nacional. Se evaluaron diecinueve modelos altura-diámetro en los cuales se incluían como variables independientes, además del diámetro normal, diferentes combinaciones de las siguientes variables de masa: número de pies por hectárea, diámetro medio cuadrático, diámetro medio aritmético, diámetro dominante, altura media, altura dominante y área basimétrica. Basándose en análisis numéricos y gráficos de los residuos, se propone como relación altura-diámetro para E. globulus en Galicia una modificación del modelo de Bertalanffy-Richards, que considera el diámetro normal, el diámetro dominante y la altura dominante como variables independientes. Este modelo explicó el 82\% de la variabilidad total de los datos de altura empleados en la fase de ajuste.},
	booktitle = {Actas del 5º {Congreso} {Forestal} {Español}, Ávila},
	author = {Díaz Rodríguez, C and Crecente-Campo, F and Dieguez-Aranda, Ulises},
	year = {2009},
}

@inproceedings{lopez_comparacion_2001-1,
	title = {Comparación de modelos altura-diámetro generalizados para \textit{{Pinus}} radiata {D}. {Don} en {Galicia}},
	url = {https://www.congresoforestal.es/fichero.php?t=41725&i=1903&m=2185},
	abstract = {Nueve modelos que estiman la relación altura-diámetro en función de variables de masa (edad, número de pies por hectárea, altura dominante, diámetro dominante, diámetro medio cuadrático) fueron ajustados a datos de 7.298 árboles mediante procedimientos de regresión no lineal. Posteriormente se evaluó la precisión de los modelos ajustados a partir de una muestra de 2.388 árboles independientes del ajuste. Todos estos datos pertenecen a dos inventarios de 182 parcelas permanentes de pino radiata (Pinus radiata D. Don) distribuidas por la Comunidad Autónoma de Galicia. La comparación entre los modelos se ha basado en el estudio del coeficiente de determinación, el error medio cuadrático y el análisis de los residuos.},
	booktitle = {Actas del 3er {Congreso} {Forestal} {Español}, {Granada}},
	author = {López, C. A. and Gorgoso, J and Castedo, F.},
	year = {2001},
}

